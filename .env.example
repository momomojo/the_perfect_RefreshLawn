# RefreshLawn Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# STRIPE CONFIGURATION
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_*) for development, live keys (pk_live_*) for production
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ============================================
# GOOGLE REVIEWS INTEGRATION (OPTIONAL)
# ============================================
# REQUIRED for proper Google Reviews redirect when customers rate 4-5 stars
# Without this, reviews will redirect to generic Google search
#
# How to get your Google Place ID:
# 1. Visit: https://developers.google.com/maps/documentation/places/web-service/place-id
# 2. Click "Place ID Finder"
# 3. Search for your business name and location
# 4. Copy the Place ID (format: ChIJxxxxxxxxxxxxx)
#
# OR from Google Maps:
# 1. Search for your business on Google Maps
# 2. Click on your business listing
# 3. The Place ID is embedded in the URL
#
# Example: ChIJN1t_tDeuEmsRUsoyG83frY4 (NOT a real Place ID)
EXPO_PUBLIC_GOOGLE_PLACE_ID=ChIJyour_google_place_id_here

# ============================================
# SENTRY ERROR TRACKING (PRODUCTION)
# ============================================
# Get your DSN from: https://sentry.io/settings/projects/
# Leave blank for development (Sentry will be disabled)
SENTRY_DSN=

# ============================================
# NOTES
# ============================================
# 1. All client-side variables MUST start with EXPO_PUBLIC_
# 2. Server-side variables (Supabase Edge Functions) go in supabase/functions/.env
# 3. Run "npm run validate-env" to verify your configuration
# 4. Restart development server after changing .env: npm start
#
# For more details, see: ENVIRONMENT_SETUP.md
