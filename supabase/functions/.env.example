# =============================================================================
# Supabase Edge Functions - Environment Variables
# =============================================================================
# This file is for local Edge Function development only.
# For remote/production, use: supabase secrets set VARIABLE_NAME="value"
#
# IMPORTANT: Never commit actual secret keys to version control!
# Copy this to .env.local and add your actual keys there.

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Supabase Configuration (auto-provided by Supabase CLI for local development)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key

# Instructions:
# 1. Get your Stripe secret key from: https://dashboard.stripe.com/test/apikeys
# 2. Copy this file to .env.local
# 3. Replace the placeholder values with your actual keys
# 4. For remote deployment, use: supabase secrets set STRIPE_SECRET_KEY="sk_test_..."
