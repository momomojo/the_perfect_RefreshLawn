    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.4",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
