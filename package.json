{
  "name": "test-tempo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "supabase:start": "node ./scripts/supabase-control.js start",
    "supabase:stop": "node ./scripts/supabase-control.js stop",
    "supabase:status": "node ./scripts/supabase-control.js status",
    "supabase:restart": "node ./scripts/supabase-control.js restart",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-env": "node ./scripts/validate-env.js",
    "logs:prod": "bash scripts/logs/tail-production.sh",
    "logs:webhook": "bash scripts/logs/tail-stripe-webhook.sh",
    "logs:payment": "bash scripts/logs/tail-stripe-payment.sh",
    "logs:receiver": "bash scripts/logs/start-webhook-receiver.sh",
    "logs:launch": "node scripts/logs/launch-dev.js",
    "update:dev": "bash scripts/publish-update.sh development",
    "update:staging": "bash scripts/publish-update.sh staging",
    "update:prod": "bash scripts/publish-update.sh production",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
